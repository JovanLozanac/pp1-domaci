	N = 1
	adrNiza = 2
	adrDozvoljenih = 3
	i = 4
	j = 5
	tmp1 = 6
	tmp2 = 7
	org 8
	
pocetak: in N
	mov tmp1, 1
	bgt tmp1, N, kraj
	mov tmp1, 100
	bgt N, tmp1, kraj
	mov adrNiza, 100
	in (adrNiza), N
	mov adrDozvoljenih, 200
	in (adrDozvoljenih), 4
	out (adrNiza), N
	mov i, 0
	mov j, 0
	jsr ppObrada
	mov adrNiza, 100
	out (adrNiza), N
	beq N, N, pocetak
	
kraj: stop
	
ppObrada: beq i, N, krajppObrade
	mov j, 0
petlja:	mov tmp1, 4
	beq j, tmp1, brisanjeIzNiza
	beq (adrNiza), (adrDozvoljenih), krajZaElement
	add adrDozvoljenih, adrDozvoljenih, 1
	add j, j, 1
	beq j, j, petlja
	
	;naredna 2 bloka se izvrsavaju ako je pronadjen dozvoljen element
	;a drugi od njih u oba slucaja i predstavlja produzetak bloka izbacivanja
krajZaElement: add adrNiza, adrNiza, 1
	add i, i, 1
nedozvoljeni: mov adrDozvoljenih, 200
	beq i, i, ppObrada
	
	;naredni blok se izvrsava ako element nije u dozvoljenima
	;predstavlja izguravanje nedozvoljenog clana niza na poslednje mesto
	;i smanjenje duzine niza za 1
brisanjeIzNiza: mov tmp1, adrNiza
petljaBrisanja:	sub tmp1, tmp1, 100
	sub N, N, 1
	beq tmp1, N, nedozvoljeni ;ovo je provera da li je poslednji
	add N, N, 1 ;vracanje na normalu
	add tmp1, tmp1, 100
	
	mov tmp2, tmp1
	add tmp2, tmp2, 1
	mov (tmp1), (tmp2)
	add tmp1, tmp1, 1
	add tmp2, tmp2, 1
	beq tmp2, tmp2, petljaBrisanja

krajppObrade: rts